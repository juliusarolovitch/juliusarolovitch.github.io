---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Globe from '../../components/Globe.astro';
import { countryOf, formatCoords } from '../../lib/geo';

export async function getStaticPaths() {
  const posts = (await getCollection('travel', (p) => !p.data.draft)).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return posts.map((post, i) => ({ params: { id: post.id }, props: { post, prev: posts[i - 1], next: posts[i + 1] } }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const country = countryOf(post.data.coords, post.data.country);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="head">
      <div>
        <p class="crumb"><a href="/travel/">Travel</a> / {post.data.place}</p>
        <h1>{post.data.title}</h1>
        {post.data.description && <p class="lede">{post.data.description}</p>}
        <p class="meta">
          {[post.data.place, country].filter(Boolean).join(', ')}<br />
          {formatCoords(post.data.coords)}<br />
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
          </time>
        </p>
      </div>
      <Globe coords={post.data.coords} />
    </header>
    {post.data.cover && <Image src={post.data.cover} alt="" width={1400} class="cover" />}
    <div class="prose">
      <Content />
    </div>
    <nav class="pager">
      {prev ? <a href={`/travel/${prev.id}/`}>← {prev.data.place}</a> : <span />}
      {next && <a href={`/travel/${next.id}/`}>{next.data.place} →</a>}
    </nav>
  </article>
</Base>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .crumb {
    margin: 1.5rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .crumb a {
    color: var(--muted);
  }

  h1 {
    font-size: clamp(1.9rem, 5vw, 2.5rem);
    margin: 0.4rem 0 0.5rem;
  }

  .lede {
    font-size: 1.12rem;
    color: var(--muted);
    margin: 0;
  }

  .meta {
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--muted);
    margin: 0.9rem 0 0;
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 2rem;
    border-radius: 10px;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 560px) {
    .head {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
