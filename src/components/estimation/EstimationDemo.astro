---
interface Props { kind: 'observer' | 'scalar' | 'covariance' | 'ekf' }
const { kind } = Astro.props;
const controls = {
  observer: [ ['Gain ℓ', 'gain', 0, 8, 0.05, 0.8], ['Position noise σ (m)', 'noise', 0, 1, 0.05, 0.4] ],
  scalar: [ ['Assumed Q ((rad/s)²)', 'q', -3, 0, 0.05, Math.log10(0.04)], ['Assumed R ((rad/s)²)', 'r', -2, 1, 0.05, 0] ],
  covariance: [ ['Correlation ρ', 'rho', -0.95, 0.95, 0.001, Math.SQRT1_2], ['Sensor R (m²)', 'r', 0.1, 5, 0.1, 1] ],
  ekf: [ ['Prior position (m)', 'position', -4, 4, 0.1, 3], ['Prior σ (m)', 'sigma', 0.1, 2, 0.1, 1] ],
} as const;
const descriptions = {
  observer: 'True cart position, position sensor samples, and observer estimate over time',
  scalar: 'Motor speed measurements, Kalman estimate, and reported two-standard-deviation band',
  covariance: 'Prior and posterior position-velocity covariance ellipses',
  ekf: 'Nonlinear range measurement and its local tangent approximation',
};
---
<figure class="viz" data-estimation={kind}>
  <div class="viz-controls">
    {controls[kind].map(([label, key, min, max, step, value]) => (
      <label>{label}<input type="range" min={min} max={max} step={step} value={value} data-key={key} /><output></output></label>
    ))}
  </div>
  <canvas role="img" aria-label={descriptions[kind]}></canvas>
  <p class="viz-status" data-status aria-live="polite"></p>
  <figcaption>
    {kind === 'observer' && 'Solid dark: true cart position. Gray dots: position sensor. Teal: estimated position. The cart moves at a known 1 m/s.'}
    {kind === 'scalar' && 'Solid dark: true motor speed. Gray dots: encoder. Teal: estimate and reported ±2σ band. Time in seconds; angular speed in rad/s. Fixed data; sliders change filter assumptions only.'}
    {kind === 'covariance' && 'Dashed dark: prior contour. Solid teal: posterior contour. Crosses mark their means. Horizontal: position (m); vertical: velocity (m/s). One position reading z = 2 m.'}
    {kind === 'ekf' && 'Solid dark: true range function. Dashed teal: tangent at the prior. Dotted horizontal: measured range z = 4 m. Shading: prior position ±2σ. Cross: EKF corrected position on the true curve.'}
  </figcaption>
</figure>

<script>
  import { fitCanvas, panel, redrawOn, theme } from '../../lib/viz';

  // Fixed independent Gaussian draws keep comparisons reproducible as controls move.
  let seed = 73;
  const uniform = () => (seed = seed * 16807 % 2147483647) / 2147483647;
  const normal = () => Math.sqrt(-2 * Math.log(uniform())) * Math.cos(2 * Math.PI * uniform());
  const noise = Array.from({ length: 400 }, normal);
  const process = Array.from({ length: 160 }, normal);
  const readings = Array.from({ length: 160 }, normal);

  for (const root of document.querySelectorAll<HTMLElement>('[data-estimation]')) {
    const canvas = root.querySelector('canvas')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const kind = root.dataset.estimation!;
    const sliders = [...root.querySelectorAll<HTMLInputElement>('input')];
    const draw = () => {
      const values: Record<string, number> = {};
      sliders.forEach(input => {
        const key = input.dataset.key!;
        const value = kind === 'scalar' ? 10 ** Number(input.value) : Number(input.value);
        values[key] = value;
        input.nextElementSibling!.textContent = value.toFixed(kind === 'scalar' ? 3 : 2);
        input.setAttribute('aria-valuetext', value.toFixed(3));
      });
      const t = theme();
      const { ctx, width } = fitCanvas(canvas, 300);
      const box = { x: 42, y: 22, w: width - 55, h: 239 };
      const path = (points: number[][], sx: (v: number) => number, sy: (v: number) => number, color: string, dash: number[] = []) => {
        ctx.beginPath(); ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.setLineDash(dash);
        points.forEach(([a,b], i) => i ? ctx.lineTo(sx(a), sy(b)) : ctx.moveTo(sx(a), sy(b)));
        ctx.stroke(); ctx.setLineDash([]);
      };
      const dots = (points: number[][], sx: (v: number) => number, sy: (v: number) => number) => {
        ctx.fillStyle = t.muted; ctx.globalAlpha = 0.5;
        points.forEach(([a,b]) => { ctx.beginPath(); ctx.arc(sx(a), sy(b), 1.7, 0, 2*Math.PI); ctx.fill(); });
        ctx.globalAlpha = 1;
      };
      const cross = (a: number, b: number, sx: (v: number) => number, sy: (v: number) => number, color: string) => {
        const x = sx(a), y = sy(b); ctx.strokeStyle = color; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(x-5,y); ctx.lineTo(x+5,y); ctx.moveTo(x,y-5); ctx.lineTo(x,y+5); ctx.stroke();
      };
      const ticks = (sx: (v: number) => number, vals: number[], suffix: string) => {
        ctx.fillStyle = t.muted; ctx.font = `11px ${t.mono}`; ctx.textAlign = 'center'; ctx.textBaseline = 'top';
        vals.forEach(v => ctx.fillText(`${v}${suffix}`, sx(v), 271));
      };
      const clip = () => { ctx.save(); ctx.beginPath(); ctx.rect(box.x,box.y,box.w,box.h); ctx.clip(); };

      if (kind === 'observer' || kind === 'scalar') {
        const truth: number[][] = [], measured: number[][] = [], estimated: number[][] = [], variances: number[] = [];
        let estimate = kind === 'observer' ? 0 : 20, P = 4, gain = 0, error = 0, covered = 0;
        let state = kind === 'observer' ? 1 : 20;
        const n = kind === 'observer' ? 400 : 160;
        for (let k=0;k<n;k++) {
          const time = kind === 'observer' ? k*0.02 : k*0.1;
          let z: number;
          if (kind === 'observer') {
            state = 1 + time;
            z = state + values.noise*noise[k];
            truth.push([time,state]); measured.push([time,z]); estimated.push([time,estimate]);
            estimate += 0.02*(1 + values.gain*(z-estimate));
          } else {
            const alpha = Math.exp(-0.2*0.1), beta = 10*(1-alpha);
            const voltage = k < 40 ? 2 : k < 100 ? 4 : 1;
            state = alpha*state + beta*voltage + 0.2*process[k]; z = state + readings[k];
            estimate = alpha*estimate + beta*voltage;
            P = alpha*alpha*P + values.q; gain = P/(P+values.r);
            estimate += gain*(z-estimate); P *= 1-gain;
            truth.push([time,state]); measured.push([time,z]); estimated.push([time,estimate]); variances.push(P);
            error += (state-estimate)**2;
            if (Math.abs(state-estimate)<=2*Math.sqrt(P)) covered++;
          }
        }
        const all = [...truth,...measured,...estimated].map(p => p[1]);
        if (kind === 'scalar') estimated.forEach((p,i) => all.push(p[1]-2*Math.sqrt(variances[i]),p[1]+2*Math.sqrt(variances[i])));
        const {x,y} = panel(ctx,box,[0,kind === 'observer' ? 8 : 16],[Math.min(...all)-0.2,Math.max(...all)+0.2],kind === 'observer' ? 'Position (m)' : 'Angular speed (rad/s)');
        clip();
        if (kind === 'scalar') {
          ctx.beginPath(); estimated.forEach(([a,b],i) => i ? ctx.lineTo(x(a),y(b+2*Math.sqrt(variances[i]))) : ctx.moveTo(x(a),y(b+2*Math.sqrt(variances[i]))));
          for (let i=n-1;i>=0;i--) ctx.lineTo(x(estimated[i][0]),y(estimated[i][1]-2*Math.sqrt(variances[i])));
          ctx.closePath(); ctx.fillStyle=t.accent; ctx.globalAlpha=0.15; ctx.fill(); ctx.globalAlpha=1;
        }
        dots(measured,x,y); path(truth,x,y,t.fg); path(estimated,x,y,t.accent); ctx.restore();
        ticks(x,kind === 'observer' ? [0,2,4,6,8] : [0,4,8,12,16],' s');
        status.textContent = kind === 'observer'
          ? `Error time constant = ${values.gain > 0 ? (1/values.gain).toFixed(2) + " s" : "∞ (no correction)"}. Gain ℓ = ${values.gain.toFixed(2)} /s.`
          : `Final gain = ${gain.toFixed(3)} · Final σ = ${Math.sqrt(P).toFixed(3)} rad/s · RMSE = ${Math.sqrt(error/n).toFixed(3)} rad/s · Band covers truth at ${Math.round(100*covered/n)}% of samples (one realization).`;
      } else if (kind === 'covariance') {
        const c = values.rho*Math.SQRT2, R = values.r, S = 2+R;
        const kp=2/S, kv=c/S;
        const posterior = [2-4/S,c-2*c/S,1-c*c/S];
        const {x,y} = panel(ctx,box,[-2.5,5],[-2.5,4.5],'Velocity (m/s)');
        const ellipse = (a: number,b: number,d: number, cx: number,cy: number,color: string,dash: number[]) => {
          // Cholesky maps a unit circle into the covariance contour.
          const l11=Math.sqrt(a), l21=b/l11, l22=Math.sqrt(Math.max(0,d-l21*l21));
          const points = Array.from({length:181},(_,i) => {
            const angle=i*Math.PI/90, u=2*Math.cos(angle), v=2*Math.sin(angle);
            return [cx+l11*u,cy+l21*u+l22*v];
          });
          path(points,x,y,color,dash); cross(cx,cy,x,y,color);
        };
        clip();
        path([[2,-2.5],[2,4.5]],x,y,t.muted,[2,5]);
        ellipse(2,c,1,1,1,t.fg,[5,4]); ellipse(posterior[0],posterior[1],posterior[2],1+kp,1+kv,t.accent,[]);
        ctx.restore(); ticks(x,[-2,0,2,4],'');
        status.textContent=`Prior Ppv = ${c.toFixed(3)} m²/s · K = [${kp.toFixed(3)}, ${kv.toFixed(3)} /s] · Posterior mean = [${(1+kp).toFixed(3)} m, ${(1+kv).toFixed(3)} m/s] · Pvv: 1 → ${posterior[2].toFixed(3)} m²/s²`;
      } else {
        const p=values.position, sigma=values.sigma, h=(v: number) => Math.hypot(v,2);
        const H=p/h(p), P=sigma*sigma, S=H*H*P+0.25, K=P*H/S, corrected=p+K*(4-h(p));
        const {x,y} = panel(ctx,box,[-8,8],[0,9],'Range (m)');
        clip();
        ctx.fillStyle=t.accent; ctx.globalAlpha=0.1; ctx.fillRect(x(p-2*sigma),box.y,x(p+2*sigma)-x(p-2*sigma),box.h); ctx.globalAlpha=1;
        const positions=Array.from({length:201},(_,i) => -8+16*i/200);
        path(positions.map(v => [v,h(v)]),x,y,t.fg);
        path(positions.map(v => [v,h(p)+H*(v-p)]),x,y,t.accent,[6,4]);
        path([[-8,4],[8,4]],x,y,t.muted,[2,5]);
        dots([[p,h(p)]],x,y); cross(corrected,h(corrected),x,y,t.accent);
        ctx.restore(); ticks(x,[-8,-4,0,4,8],'');
        status.textContent=`Predicted range = ${h(p).toFixed(3)} m · H = ${H.toFixed(3)} · K = ${K.toFixed(3)} · Updated position = ${corrected.toFixed(3)} m · Local posterior σ = ${Math.sqrt((1-K*H)*P).toFixed(3)} m`;
      }
    };
    sliders.forEach(input => input.addEventListener('input',draw));
    redrawOn(canvas,draw);
  }
</script>

<style>
  .viz-controls label { flex-wrap: wrap; }
  .viz-controls input { width: 7rem; }
  @media (max-width: 480px) {
    .viz { padding: 0.6rem; }
    .viz-controls { gap: 0.6rem; }
  }
</style>
