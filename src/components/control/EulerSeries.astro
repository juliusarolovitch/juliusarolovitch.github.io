---
import katex from 'katex';

const tex = (s: string) => katex.renderToString(s);
---

<figure class="viz" data-euler>
  <div class="viz-controls">
    <label><Fragment set:html={tex(String.raw`\theta`)} /> <input type="range" min="0" max="3.14" step="0.01" value="1.8" data-theta /><output data-theta-out></output></label>
    <label>terms <input type="range" min="1" max="14" step="1" value="3" data-n /><output data-n-out></output></label>
  </div>
  <canvas data-canvas role="img" aria-label="The terms of the exponential series for j theta drawn head to tail, approaching a point on the unit circle"></canvas>
  <p class="viz-status" data-status></p>
</figure>

<script>
  import { scaleLinear } from 'd3-scale';
  import { fitCanvas, redrawOn, setStatus, theme } from '../../lib/viz';

  for (const root of document.querySelectorAll<HTMLElement>('[data-euler]')) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const thIn = root.querySelector<HTMLInputElement>('[data-theta]')!;
    const nIn = root.querySelector<HTMLInputElement>('[data-n]')!;

    const draw = () => {
      const t = theme();
      const theta = Number(thIn.value);
      const n = Number(nIn.value);
      root.querySelector<HTMLOutputElement>('[data-theta-out]')!.value = `${theta.toFixed(2)} rad`;
      root.querySelector<HTMLOutputElement>('[data-n-out]')!.value = String(n);

      const points = [[0, 0]];
      let term = [1, 0];
      for (let k = 0; k < n; k++) {
        const p = points[points.length - 1];
        points.push([p[0] + term[0], p[1] + term[1]]);
        term = [(-term[1] * theta) / (k + 1), (term[0] * theta) / (k + 1)];
      }
      const all = [...points, [1.1, 1.1], [-1.1, -1.1]];
      const xs = all.map((p) => p[0]);
      const ys = all.map((p) => p[1]);
      const [x0, x1, y0, y1] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
      const width = canvas.clientWidth;
      const height = 320;
      const unit = Math.min((width - 40) / (x1 - x0), (height - 40) / (y1 - y0));
      const cx = width / 2 - ((x0 + x1) / 2) * unit;
      const cy = height / 2 + ((y0 + y1) / 2) * unit;
      const sx = scaleLinear().domain([0, 1]).range([cx, cx + unit]);
      const sy = scaleLinear().domain([0, 1]).range([cy, cy - unit]);
      const { ctx } = fitCanvas(canvas, height);

      ctx.strokeStyle = t.muted;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(0, sy(0));
      ctx.lineTo(width, sy(0));
      ctx.moveTo(sx(0), 0);
      ctx.lineTo(sx(0), height);
      ctx.stroke();
      ctx.strokeStyle = t.line;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(sx(0), sy(0), unit, 0, Math.PI * 2);
      ctx.stroke();

      const target = [Math.cos(theta), Math.sin(theta)];
      ctx.strokeStyle = t.accent;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(sx(target[0]), sy(target[1]), 9, 0, Math.PI * 2);
      ctx.stroke();

      for (let k = 1; k < points.length; k++) {
        const [a, b] = [points[k - 1], points[k]];
        const x0p = sx(a[0]);
        const y0p = sy(a[1]);
        const x1p = sx(b[0]);
        const y1p = sy(b[1]);
        const len = Math.hypot(x1p - x0p, y1p - y0p);
        ctx.strokeStyle = (k - 1) % 2 ? t.accent : t.fg;
        ctx.fillStyle = ctx.strokeStyle;
        ctx.lineWidth = 2.2;
        ctx.beginPath();
        ctx.moveTo(x0p, y0p);
        ctx.lineTo(x1p, y1p);
        ctx.stroke();
        if (len > 6) {
          const ang = Math.atan2(y1p - y0p, x1p - x0p);
          const h = Math.min(10, len * 0.45);
          ctx.beginPath();
          ctx.moveTo(x1p, y1p);
          ctx.lineTo(x1p - h * Math.cos(ang - 0.4), y1p - h * Math.sin(ang - 0.4));
          ctx.lineTo(x1p - h * Math.cos(ang + 0.4), y1p - h * Math.sin(ang + 0.4));
          ctx.fill();
        }
      }
      const end = points[points.length - 1];
      ctx.fillStyle = t.fg;
      ctx.beginPath();
      ctx.arc(sx(end[0]), sy(end[1]), 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = t.accent;
      ctx.font = '16px KaTeX_Math, serif';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'bottom';
      ctx.fillText('e', sx(target[0]) + 12, sy(target[1]) - 6);
      ctx.font = '12px KaTeX_Math, serif';
      ctx.fillText('jθ', sx(target[0]) + 22, sy(target[1]) - 14);

      const fmt = (p: number[]) => `${p[0].toFixed(3)} ${p[1] < 0 ? '-' : '+'} ${Math.abs(p[1]).toFixed(3)}j`;
      setStatus(status, `Sum of ${n} term${n > 1 ? 's' : ''}: $${fmt(end)}$   $\\cos\\theta + j\\sin\\theta = ${fmt(target)}$   gap: $${Math.hypot(end[0] - target[0], end[1] - target[1]).toFixed(4)}$`);
    };

    thIn.addEventListener('input', draw);
    nIn.addEventListener('input', draw);
    redrawOn(canvas, draw);
  }
</script>
