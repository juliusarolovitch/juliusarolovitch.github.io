---
import katex from 'katex';

const tex = (s: string) => katex.renderToString(s);
const P = (x: number, y: number) => [x * 1.6, -y * 1.05];
const pt = (x: number, y: number) => P(x, y).map((v) => v.toFixed(3)).join(' ');
const trace = (ox: number, oy: number, f: (x: number) => number, n = 150) => {
  const [cx, cy] = P(ox, oy);
  return Array.from({ length: n + 1 }, (_, i) => {
    const x = (5 * i) / n;
    return `${i ? 'L' : 'M'}${(cx + 0.05 + 0.3 * x).toFixed(3)} ${(cy - f(x)).toFixed(3)}`;
  }).join(' ');
};
const inset = (ox: number, oy: number) => {
  const [cx, cy] = P(ox, oy);
  return { x: cx, y: cy - 0.9 };
};
const modes = [
  { pole: [-3.5, 0], link: [-3.8, -0.84], at: [-4.3, -1.7], kind: 'decay', f: (x: number) => 0.1 + 0.7 * Math.exp(-3.5 * x) },
  { pole: [-0.8, 0], link: [-1.5, -0.84], at: [-2.0, -1.7], kind: 'decay', f: (x: number) => 0.1 + 0.7 * Math.exp(-0.8 * x) },
  { pole: [-0.6, 2.5], link: [-1.6, 2.53], at: [-2.6, 2.1], kind: 'decay', f: (x: number) => 0.45 + 0.38 * Math.exp(-0.6 * x) * Math.cos(2.5 * x) },
  { pole: [0, 1.8], link: [-0.4, 1.4], at: [-1.4, 0.75], kind: 'hold', f: (x: number) => 0.45 + 0.35 * Math.cos(1.8 * x) },
  { pole: [0.6, 2.5], link: [0.9, 2.53], at: [0.9, 2.1], kind: 'grow', f: (x: number) => 0.45 + 0.38 * Math.exp(0.6 * (x - 5)) * Math.cos(2.5 * x) },
  { pole: [1.0, 0], link: [1.2, -0.84], at: [0.7, -1.7], kind: 'grow', f: (x: number) => 0.1 + 0.7 * Math.exp(1.0 * (x - 5)) },
];
const conjugates = [
  [-0.6, -2.5],
  [0, -1.8],
  [0.6, -2.5],
];
const cross = ([x, y]: number[]) => {
  const [cx, cy] = P(x, y);
  return `M${cx - 0.11} ${cy - 0.105}L${cx + 0.11} ${cy + 0.105}M${cx - 0.11} ${cy + 0.105}L${cx + 0.11} ${cy - 0.105}`;
};
const gridX = [-4, -3, -2, -1, 0, 1, 2];
const gridY = [-3, -2, -1, 0, 1, 2, 3];
const [left, top] = P(-4.4, 3.3);
const [right, bottom] = P(2.0, -3.3);
const [zx] = P(0, 0);
---

<figure class="viz cmap">
  <svg viewBox="-7.6 -4.1 11.9 7.85" role="img" aria-label="The complex plane as a map of natural motion, with example eigenvalues and the motion of each mode">
    <defs>
      <marker id="cmap-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="head"></path>
      </marker>
    </defs>
    <rect class="lhp" x={left} y={top} width={zx - left} height={bottom - top}></rect>
    <rect class="rhp" x={zx} y={top} width={right - zx} height={bottom - top}></rect>
    {gridX.map((g) => <line class="grid" x1={P(g, 0)[0]} x2={P(g, 0)[0]} y1={top} y2={bottom}></line>)}
    {gridY.map((g) => <line class="grid" x1={left} x2={right} y1={P(0, g)[1]} y2={P(0, g)[1]}></line>)}
    <line class="axis" x1={P(-4.6, 0)[0]} y1="0" x2={P(2.25, 0)[0]} y2="0" marker-end="url(#cmap-arrow)"></line>
    <line class="axis" x1={zx} y1={P(0, -3.45)[1]} x2={zx} y2={P(0, 3.5)[1]} marker-end="url(#cmap-arrow)"></line>
    <foreignObject x={P(2.28, 0)[0]} y="-0.28" width="0.7" height="0.6"><div class="label" set:html={tex(String.raw`\sigma`)} /></foreignObject>
    <foreignObject x={zx - 0.3} y={P(0, 3.5)[1] - 0.62} width="0.8" height="0.6"><div class="label" set:html={tex(String.raw`j\omega`)} /></foreignObject>
    <text class="region decay" x={P(-4.35, 0)[0]} y={P(0, -3.25)[1] - 0.06}>modes decay</text>
    <text class="region grow" x={P(1.95, 0)[0]} y={P(0, -3.25)[1] - 0.06} text-anchor="end">modes grow</text>

    {conjugates.map((c) => <path class="pole" d={cross(c)}></path>)}
    {
      modes.map((m) => {
        const box = inset(m.at[0], m.at[1]);
        return (
          <g class:list={['mode', m.kind]} tabindex="0">
            <line class="link" x1={P(m.pole[0], m.pole[1])[0]} y1={P(m.pole[0], m.pole[1])[1]} x2={P(m.link[0], m.link[1])[0]} y2={P(m.link[0], m.link[1])[1]}></line>
            <rect class="inset" x={box.x} y={box.y} width="1.6" height="0.9" rx="0.04"></rect>
            <path class="trace" d={trace(m.at[0], m.at[1], m.f)}></path>
            <path class="pole" d={cross(m.pole)}></path>
          </g>
        );
      })
    }

    <line class="hint" x1={P(-3.5, 0.3)[0]} y1={P(0, 0.3)[1]} x2={P(-0.8, 0.3)[0]} y2={P(0, 0.3)[1]} marker-start="url(#cmap-arrow)" marker-end="url(#cmap-arrow)"></line>
    <text class="hint-text" x={P(-2.15, 0)[0]} y={P(0, 0.3)[1] - 0.12} text-anchor="middle">farther left: faster decay</text>
    <line class="hint" x1={P(-3.0, 0)[0]} y1={P(0, 1.0)[1]} x2={P(-3.0, 0)[0]} y2={P(0, 2.5)[1]} marker-start="url(#cmap-arrow)" marker-end="url(#cmap-arrow)"></line>
    <text class="hint-text" x={P(-3.0, 0)[0] - 0.12} y={P(0, 1.75)[1] - 0.06} text-anchor="end">higher:</text>
    <text class="hint-text" x={P(-3.0, 0)[0] - 0.12} y={P(0, 1.75)[1] + 0.3} text-anchor="end">faster turning</text>
  </svg>
</figure>

<style>
  .cmap {
    --decay: #2f6fd6;
    --grow: #e03131;
  }

  @media (prefers-color-scheme: dark) {
    .cmap {
      --decay: #7aa7ff;
      --grow: #ff8787;
    }
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--sans);
  }

  .lhp {
    fill: color-mix(in srgb, var(--decay) 10%, transparent);
  }

  .rhp {
    fill: color-mix(in srgb, var(--grow) 10%, transparent);
  }

  .grid {
    stroke: var(--line);
    stroke-width: 0.02;
  }

  .axis {
    stroke: var(--fg);
    stroke-width: 0.035;
  }

  .head {
    fill: var(--fg);
  }

  .label {
    color: var(--fg);
    font-size: 0.34px;
    line-height: 1;
  }

  .region {
    font-size: 0.3px;
  }

  .region.decay {
    fill: var(--decay);
  }

  .region.grow {
    fill: var(--grow);
  }

  .pole {
    stroke: var(--fg);
    stroke-width: 0.05;
    fill: none;
    stroke-linecap: round;
  }

  .link {
    stroke: var(--muted);
    stroke-width: 0.018;
  }

  .inset {
    fill: var(--surface);
    stroke: var(--muted);
    stroke-width: 0.02;
    transition: stroke 0.15s ease;
  }

  .trace {
    fill: none;
    stroke-width: 0.04;
    stroke-linejoin: round;
    transition: stroke-width 0.15s ease;
  }

  .decay .trace {
    stroke: var(--decay);
  }

  .hold .trace {
    stroke: var(--fg);
  }

  .grow .trace {
    stroke: var(--grow);
  }

  .mode {
    cursor: default;
    outline: none;
  }

  .mode:hover .inset,
  .mode:focus-visible .inset {
    stroke: var(--accent);
    stroke-width: 0.04;
  }

  .mode:hover .trace,
  .mode:focus-visible .trace {
    stroke-width: 0.065;
  }

  .mode:hover .pole,
  .mode:focus-visible .pole,
  .mode:hover .link,
  .mode:focus-visible .link {
    stroke: var(--accent);
  }

  .hint {
    stroke: var(--accent);
    stroke-width: 0.03;
  }

  .hint-text {
    font-size: 0.24px;
    fill: var(--accent);
  }
</style>
