---
import katex from 'katex';

const tex = (s: string) => katex.renderToString(s);
---

<figure class="viz" data-crate>
  <div class="viz-controls">
    <label><Fragment set:html={tex(String.raw`\sigma`)} /> <input type="range" min="-0.5" max="0.3" step="0.01" value="-0.1" data-sigma /><output data-sigma-out></output></label>
    <label><Fragment set:html={tex(String.raw`\omega`)} /> <input type="range" min="0" max="3" step="0.05" value="1" data-omega /><output data-omega-out></output></label>
  </div>
  <div class="crate-grid">
    <canvas data-plane role="img" aria-label="The point z(t) moving in the complex plane, with its radius and velocity"></canvas>
    <canvas data-time role="img" aria-label="The real part of z(t) over time, with its envelope"></canvas>
  </div>
  <p class="viz-status" data-status></p>
</figure>

<style>
  .crate-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .crate-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { scaleLinear } from 'd3-scale';
  import { fitCanvas, panel, redrawOn, setStatus, theme } from '../../lib/viz';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('[data-crate]')) {
    const plane = root.querySelector<HTMLCanvasElement>('[data-plane]')!;
    const time = root.querySelector<HTMLCanvasElement>('[data-time]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const sIn = root.querySelector<HTMLInputElement>('[data-sigma]')!;
    const wIn = root.querySelector<HTMLInputElement>('[data-omega]')!;
    let now = reduced ? Infinity : 0;
    let visible = false;

    const params = () => {
      const sigma = Number(sIn.value);
      const omega = Number(wIn.value);
      const z0 = sigma > 0 ? 0.25 : 1;
      const tmax = sigma > 0 ? Math.min(20, Math.log(1.1 / z0) / sigma) : 20;
      return { sigma, omega, z0, tmax };
    };

    const arrow = (ctx: CanvasRenderingContext2D, x0: number, y0: number, x1: number, y1: number) => {
      const a = Math.atan2(y1 - y0, x1 - x0);
      ctx.beginPath();
      ctx.moveTo(x0, y0);
      ctx.lineTo(x1, y1);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x1 - 9 * Math.cos(a - 0.4), y1 - 9 * Math.sin(a - 0.4));
      ctx.lineTo(x1 - 9 * Math.cos(a + 0.4), y1 - 9 * Math.sin(a + 0.4));
      ctx.fill();
    };

    const draw = () => {
      const t = theme();
      const { sigma, omega, z0, tmax } = params();
      root.querySelector<HTMLOutputElement>('[data-sigma-out]')!.value = sigma.toFixed(2);
      root.querySelector<HTMLOutputElement>('[data-omega-out]')!.value = omega.toFixed(2);
      const tc = Math.min(now, tmax);
      const z = (tt: number) => [z0 * Math.exp(sigma * tt) * Math.cos(omega * tt), z0 * Math.exp(sigma * tt) * Math.sin(omega * tt)];
      const n = 600;
      const samples = Array.from({ length: n + 1 }, (_, i) => (i / n) * tmax);

      {
        const width = plane.clientWidth;
        const size = Math.min(width, 280);
        const { ctx } = fitCanvas(plane, size);
        const ox = width / 2;
        const sx = scaleLinear().domain([-1.25, 1.25]).range([ox - size / 2 + 8, ox + size / 2 - 8]);
        const sy = scaleLinear().domain([-1.25, 1.25]).range([size - 8, 8]);
        ctx.strokeStyle = t.line;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(sx(0), sy(0), sx(1) - sx(0), 0, Math.PI * 2);
        ctx.stroke();
        ctx.strokeStyle = t.muted;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(sx(-1.25), sy(0));
        ctx.lineTo(sx(1.25), sy(0));
        ctx.moveTo(sx(0), sy(-1.25));
        ctx.lineTo(sx(0), sy(1.25));
        ctx.stroke();
        ctx.fillStyle = t.muted;
        ctx.font = `11px ${t.mono}`;
        ctx.textAlign = 'right';
        ctx.textBaseline = 'bottom';
        ctx.fillText('real', sx(1.25), sy(0) - 3);
        ctx.textAlign = 'left';
        ctx.textBaseline = 'top';
        ctx.fillText('imaginary', sx(0) + 5, sy(1.25));

        ctx.strokeStyle = t.accent;
        ctx.lineJoin = 'round';
        ctx.globalAlpha = 0.22;
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        samples.forEach((s, i) => {
          const [u, v] = z(s);
          if (i) ctx.lineTo(sx(u), sy(v));
          else ctx.moveTo(sx(u), sy(v));
        });
        ctx.stroke();
        ctx.globalAlpha = 1;
        ctx.lineWidth = 2.4;
        ctx.beginPath();
        samples
          .filter((s) => s <= tc)
          .forEach((s, i) => {
            const [u, v] = z(s);
            if (i) ctx.lineTo(sx(u), sy(v));
            else ctx.moveTo(sx(u), sy(v));
          });
        ctx.stroke();

        const [u, v] = z(tc);
        const du = sigma * u - omega * v;
        const dv = omega * u + sigma * v;
        const scale = 0.6;
        ctx.strokeStyle = t.fg;
        ctx.fillStyle = t.fg;
        ctx.lineWidth = 1.6;
        arrow(ctx, sx(0), sy(0), sx(u), sy(v));
        ctx.strokeStyle = t.accent;
        ctx.fillStyle = t.accent;
        ctx.lineWidth = 2;
        if (Math.hypot(du, dv) > 1e-6) arrow(ctx, sx(u), sy(v), sx(u + scale * du), sy(v + scale * dv));
        ctx.beginPath();
        ctx.arc(sx(u), sy(v), 4.5, 0, Math.PI * 2);
        ctx.fill();
      }

      {
        const { ctx, width } = fitCanvas(time, 280);
        const box = { x: 40, y: 8, w: width - 50, h: 240 };
        const { x, y } = panel(ctx, box, [0, 20], [-1.15, 1.15], 'real part over time');
        ctx.save();
        ctx.beginPath();
        ctx.rect(box.x, box.y, box.w, box.h);
        ctx.clip();
        ctx.setLineDash([4, 4]);
        ctx.strokeStyle = t.muted;
        ctx.lineWidth = 1.2;
        for (const sign of [1, -1]) {
          ctx.beginPath();
          samples.forEach((s, i) => (i ? ctx.lineTo(x(s), y(sign * z0 * Math.exp(sigma * s))) : ctx.moveTo(x(s), y(sign * z0 * Math.exp(sigma * s)))));
          ctx.stroke();
        }
        ctx.setLineDash([]);
        ctx.strokeStyle = t.accent;
        ctx.lineWidth = 2.4;
        ctx.beginPath();
        samples
          .filter((s) => s <= tc)
          .forEach((s, i) => (i ? ctx.lineTo(x(s), y(z(s)[0])) : ctx.moveTo(x(s), y(z(s)[0]))));
        ctx.stroke();
        ctx.restore();
        ctx.fillStyle = t.muted;
        ctx.font = `11px ${t.mono}`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        for (const s of [0, 5, 10, 15, 20]) ctx.fillText(`${s} s`, x(s), box.y + box.h + 6);
      }

      const fate = sigma < -1e-9 ? 'the radius shrinks: the mode decays' : sigma > 1e-9 ? 'the radius grows: the mode is unstable' : 'the radius holds: the oscillation persists';
      const turn = omega > 1e-9 ? `one turn takes $${((2 * Math.PI) / omega).toFixed(2)}\\,\\text{s}$` : 'no turning at all';
      setStatus(status, `$s = ${sigma.toFixed(2)} ${omega >= 0 ? '+' : '-'} ${Math.abs(omega).toFixed(2)}j$: ${fate}, and ${turn}.`);
    };

    const restart = () => {
      now = reduced ? Infinity : 0;
      draw();
    };

    sIn.addEventListener('input', restart);
    wIn.addEventListener('input', restart);
    redrawOn(time, draw);

    if (!reduced) {
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(plane);
      const loop = () => {
        if (visible) {
          const { tmax } = params();
          now = now > tmax + 1.5 ? 0 : now + 0.04;
          draw();
        }
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>
