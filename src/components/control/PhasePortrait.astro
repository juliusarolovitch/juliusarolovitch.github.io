---
import katex from 'katex';

const tex = (s: string) => katex.renderToString(s);
---

<figure class="viz" data-phase>
  <div class="viz-controls">
    <label><Fragment set:html={tex('k/m')} /> <input type="range" min="0" max="4" step="0.05" value="1" data-k /><output data-k-out></output></label>
    <label><Fragment set:html={tex('c/m')} /> <input type="range" min="-0.3" max="3" step="0.05" value="0.4" data-c /><output data-c-out></output></label>
  </div>
  <canvas data-canvas role="img" aria-label="Vector field of the cart in the plane of position and velocity, with one trajectory" style="cursor: crosshair"></canvas>
  <p class="viz-status" data-status></p>
</figure>

<script>
  import { scaleLinear } from 'd3-scale';
  import { fitCanvas, redrawOn, setStatus, theme } from '../../lib/viz';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('[data-phase]')) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const kIn = root.querySelector<HTMLInputElement>('[data-k]')!;
    const cIn = root.querySelector<HTMLInputElement>('[data-c]')!;
    let release = [2.2, 0];
    let path: number[][] = [];
    let shown = 0;
    let visible = false;

    const field = (x: number[]) => [x[1], -Number(kIn.value) * x[0] - Number(cIn.value) * x[1]];

    const simulate = () => {
      path = [release];
      let x = release;
      const dt = 0.02;
      for (let i = 0; i < 3000; i++) {
        const k1 = field(x);
        const k2 = field([x[0] + (dt / 2) * k1[0], x[1] + (dt / 2) * k1[1]]);
        const k3 = field([x[0] + (dt / 2) * k2[0], x[1] + (dt / 2) * k2[1]]);
        const k4 = field([x[0] + dt * k3[0], x[1] + dt * k3[1]]);
        x = [x[0] + (dt / 6) * (k1[0] + 2 * k2[0] + 2 * k3[0] + k4[0]), x[1] + (dt / 6) * (k1[1] + 2 * k2[1] + 2 * k3[1] + k4[1])];
        path.push(x);
        if (Math.hypot(x[0], x[1]) > 20 || Math.hypot(x[0], x[1]) < 2e-3) break;
      }
      shown = reduced ? path.length : 1;
    };

    const scales = () => {
      const width = canvas.clientWidth;
      const height = Math.round(Math.min(440, width * 0.72));
      return {
        height,
        sx: scaleLinear().domain([-3.4, 3.4]).range([12, width - 12]),
        sy: scaleLinear().domain([-2.7, 2.7]).range([height - 12, 12]),
      };
    };

    const draw = () => {
      const t = theme();
      const k = Number(kIn.value);
      const c = Number(cIn.value);
      root.querySelector<HTMLOutputElement>('[data-k-out]')!.value = k.toFixed(2);
      root.querySelector<HTMLOutputElement>('[data-c-out]')!.value = c.toFixed(2);
      const { height, sx, sy } = scales();
      const { ctx, width } = fitCanvas(canvas, height);

      ctx.strokeStyle = t.line;
      ctx.lineWidth = 1;
      for (let g = -3; g <= 3; g++) {
        ctx.beginPath();
        ctx.moveTo(sx(g), sy(-2.7));
        ctx.lineTo(sx(g), sy(2.7));
        ctx.stroke();
      }
      for (let g = -2; g <= 2; g++) {
        ctx.beginPath();
        ctx.moveTo(sx(-3.4), sy(g));
        ctx.lineTo(sx(3.4), sy(g));
        ctx.stroke();
      }
      ctx.strokeStyle = t.muted;
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(sx(-3.4), sy(0));
      ctx.lineTo(sx(3.4), sy(0));
      ctx.moveTo(sx(0), sy(-2.7));
      ctx.lineTo(sx(0), sy(2.7));
      ctx.stroke();
      ctx.fillStyle = t.muted;
      ctx.font = `11px ${t.mono}`;
      ctx.textAlign = 'right';
      ctx.textBaseline = 'bottom';
      ctx.fillText('position', width - 14, sy(0) - 4);
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      ctx.fillText('velocity', sx(0) + 6, 14);

      ctx.strokeStyle = t.fg;
      ctx.fillStyle = t.fg;
      ctx.globalAlpha = 0.35;
      ctx.lineWidth = 1.2;
      for (let a = -3; a <= 3.001; a += 0.5) {
        for (let b = -2.5; b <= 2.501; b += 0.5) {
          const v = field([a, b]);
          const px = v[0] * (sx(1) - sx(0));
          const py = v[1] * (sy(1) - sy(0));
          const n = Math.hypot(px, py);
          if (n < 1e-9) continue;
          const ux = (px / n) * 11;
          const uy = (py / n) * 11;
          const x0 = sx(a) - ux / 2;
          const y0 = sy(b) - uy / 2;
          ctx.beginPath();
          ctx.moveTo(x0, y0);
          ctx.lineTo(x0 + ux, y0 + uy);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(x0 + ux * 1.25, y0 + uy * 1.25);
          ctx.lineTo(x0 + ux - uy * 0.3, y0 + uy + ux * 0.3);
          ctx.lineTo(x0 + ux + uy * 0.3, y0 + uy - ux * 0.3);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;

      ctx.save();
      ctx.beginPath();
      ctx.rect(0, 0, width, height);
      ctx.clip();
      ctx.strokeStyle = t.accent;
      ctx.lineWidth = 2.6;
      ctx.lineJoin = 'round';
      ctx.beginPath();
      path.slice(0, shown).forEach((p, i) => (i ? ctx.lineTo(sx(p[0]), sy(p[1])) : ctx.moveTo(sx(p[0]), sy(p[1]))));
      ctx.stroke();
      ctx.restore();
      ctx.fillStyle = t.accent;
      ctx.beginPath();
      ctx.arc(sx(release[0]), sy(release[1]), 5, 0, Math.PI * 2);
      ctx.fill();

      const disc = c * c - 4 * k;
      const re = -c / 2;
      const eig =
        Math.abs(disc) < 1e-9
          ? `$${re.toFixed(2)}$ (twice)`
          : disc > 0
            ? `$${(re + Math.sqrt(disc) / 2).toFixed(2)}$ and $${(re - Math.sqrt(disc) / 2).toFixed(2)}$`
            : `$${re.toFixed(2)} \\pm ${(Math.sqrt(-disc) / 2).toFixed(2)}j$`;
      setStatus(status, `Released from $(${release[0].toFixed(2)}, ${release[1].toFixed(2)})$. Eigenvalues of $A$: ${eig}.`);
    };

    const restart = () => {
      simulate();
      draw();
    };

    canvas.addEventListener('pointerdown', (e) => {
      const r = canvas.getBoundingClientRect();
      const { sx, sy } = scales();
      release = [sx.invert(e.clientX - r.left), sy.invert(e.clientY - r.top)];
      restart();
    });
    kIn.addEventListener('input', restart);
    cIn.addEventListener('input', restart);
    redrawOn(canvas, draw);
    simulate();

    if (!reduced) {
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);
      const loop = () => {
        if (visible && shown < path.length) {
          shown = Math.min(path.length, shown + 5);
          draw();
        }
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>
