---
/** Low-emphasis aside for other names and notation used in the literature. */
---

<aside class="aka">
  <span class="aka-label">In other sources</span>
  <slot />
</aside>

<style>
  .aka {
    margin: 0.6rem 0 1.4rem;
    padding: 0.45rem 0.85rem 0.55rem;
    border-left: 2px solid var(--line);
    border-radius: 0 6px 6px 0;
    background: color-mix(in srgb, var(--line) 35%, transparent);
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .aka-label {
    display: block;
    margin-bottom: 0.15rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .aka :global(p) {
    margin: 0.25rem 0 0;
  }

  .aka :global(strong) {
    color: var(--muted);
    font-weight: 600;
  }

  .aka :global(.katex) {
    font-size: 1em;
  }
</style>
