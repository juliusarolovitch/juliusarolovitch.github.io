---
import katex from 'katex';

const tex = (s: string) => katex.renderToString(s);
---

<figure class="viz" data-shaping>
  <div class="viz-controls">
    <div class="viz-seg" role="group" aria-label="Shaping term">
      <button type="button" data-mode="none" aria-pressed="true">none</button>
      <button type="button" data-mode="next" aria-pressed="false"><Fragment set:html={tex(String.raw`\Phi(s')`)} /></button>
      <button type="button" data-mode="diff" aria-pressed="false"><Fragment set:html={tex(String.raw`\Phi(s') - \Phi(s)`)} /></button>
      <button type="button" data-mode="pbrs" aria-pressed="false"><Fragment set:html={tex(String.raw`\gamma\Phi(s') - \Phi(s)`)} /></button>
    </div>
    <label><Fragment set:html={tex(String.raw`k`)} /> <input type="range" min="0" max="3" step="0.05" value="1" data-k /><output data-k-out>1.00</output></label>
    <div class="viz-seg" role="group" aria-label="Heatmap">
      <button type="button" data-heat="v" aria-pressed="true">show <Fragment set:html={tex(String.raw`V`)} /></button>
      <button type="button" data-heat="phi" aria-pressed="false">show <Fragment set:html={tex(String.raw`\Phi`)} /></button>
    </div>
  </div>
  <canvas data-canvas role="img" aria-label="Gridworld with the greedy policy for the selected shaping term"></canvas>
  <p class="viz-status" data-status></p>
</figure>

<script>
  import { fitCanvas, redrawOn, setStatus, theme } from '../../lib/viz';

  const W = 11;
  const H = 7;
  const gamma = 0.9;
  const start = 1 * W + 2;
  const goal = 1 * W + 9;
  const walls = new Set([0, 1, 2, 3, 4].map((y) => y * W + 6));
  const moves = [
    [0, -1],
    [1, 0],
    [0, 1],
    [-1, 0],
  ];
  const dist = Array.from({ length: W * H }, (_, s) => Math.hypot((s % W) - (goal % W), Math.floor(s / W) - Math.floor(goal / W)));
  const dmax = Math.max(...dist);

  const step = (s: number, a: number) => {
    const x = (s % W) + moves[a][0];
    const y = Math.floor(s / W) + moves[a][1];
    return x < 0 || y < 0 || x >= W || y >= H || walls.has(y * W + x) ? s : y * W + x;
  };

  const solve = (mode: string, k: number) => {
    const phi = (s: number) => (s === goal ? 0 : k * (1 - dist[s] / dmax));
    const V = new Float64Array(W * H);
    const q = (s: number, a: number) => {
      const n = step(s, a);
      const f = mode === 'next' ? phi(n) : mode === 'diff' ? phi(n) - phi(s) : mode === 'pbrs' ? gamma * phi(n) - phi(s) : 0;
      return (n === goal ? 1 : 0) + f + (n === goal ? 0 : gamma * V[n]);
    };
    for (let it = 0; it < 5000; it++) {
      let delta = 0;
      for (let s = 0; s < W * H; s++) {
        if (walls.has(s) || s === goal) continue;
        const best = Math.max(q(s, 0), q(s, 1), q(s, 2), q(s, 3));
        delta = Math.max(delta, Math.abs(best - V[s]));
        V[s] = best;
      }
      if (delta < 1e-12) break;
    }
    const policy = Array.from({ length: W * H }, (_, s) => {
      if (walls.has(s) || s === goal) return -1;
      const qs = [0, 1, 2, 3].map((a) => q(s, a));
      const m = Math.max(...qs);
      return qs.findIndex((v) => v >= m - 1e-9);
    });
    const path = [start];
    while (path.length < 80 && path[path.length - 1] !== goal) {
      const n = step(path[path.length - 1], policy[path[path.length - 1]]);
      if (path.includes(n)) {
        path.push(n);
        break;
      }
      path.push(n);
    }
    return { V, policy, path, phi };
  };

  const baseline = solve('none', 0);

  for (const root of document.querySelectorAll<HTMLElement>('[data-shaping]')) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const slider = root.querySelector<HTMLInputElement>('[data-k]')!;
    const out = root.querySelector<HTMLOutputElement>('[data-k-out]')!;
    let mode = 'none';
    let heat = 'v';

    const draw = () => {
      const k = Number(slider.value);
      out.value = k.toFixed(2);
      const { V, policy, path, phi } = solve(mode, k);
      const t = theme();
      const cell = canvas.clientWidth / W;
      const { ctx } = fitCanvas(canvas, cell * H);
      const values = Array.from({ length: W * H }, (_, s) => (heat === 'v' ? V[s] : phi(s)));
      const open = values.filter((_, s) => !walls.has(s) && s !== goal);
      const lo = Math.min(...open);
      const hi = Math.max(...open);
      const center = (s: number) => [(s % W) * cell + cell / 2, Math.floor(s / W) * cell + cell / 2];

      for (let s = 0; s < W * H; s++) {
        const x = (s % W) * cell;
        const y = Math.floor(s / W) * cell;
        if (walls.has(s)) {
          ctx.globalAlpha = 0.8;
          ctx.fillStyle = t.muted;
        } else {
          ctx.globalAlpha = s === goal ? 0 : 0.06 + 0.55 * (hi > lo ? (values[s] - lo) / (hi - lo) : 0);
          ctx.fillStyle = t.accent;
        }
        ctx.fillRect(x, y, cell, cell);
        ctx.globalAlpha = 1;
        ctx.strokeStyle = t.line;
        ctx.lineWidth = 1;
        ctx.strokeRect(x + 0.5, y + 0.5, cell, cell);
      }

      ctx.strokeStyle = t.fg;
      ctx.fillStyle = t.fg;
      ctx.globalAlpha = 0.5;
      ctx.lineWidth = 1.4;
      const r = cell * 0.24;
      for (let s = 0; s < W * H; s++) {
        if (policy[s] < 0) continue;
        const [cx, cy] = center(s);
        const [dx, dy] = moves[policy[s]];
        ctx.beginPath();
        ctx.moveTo(cx - dx * r, cy - dy * r);
        ctx.lineTo(cx + dx * r, cy + dy * r);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(cx + dx * r, cy + dy * r);
        ctx.lineTo(cx + dx * r * 0.45 - dy * r * 0.45, cy + dy * r * 0.45 + dx * r * 0.45);
        ctx.lineTo(cx + dx * r * 0.45 + dy * r * 0.45, cy + dy * r * 0.45 - dx * r * 0.45);
        ctx.closePath();
        ctx.fill();
      }

      ctx.globalAlpha = 0.95;
      ctx.strokeStyle = t.accent;
      ctx.lineWidth = Math.max(2.5, cell * 0.07);
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';
      ctx.beginPath();
      path.forEach((s, i) => {
        const [cx, cy] = center(s);
        if (i) ctx.lineTo(cx, cy);
        else ctx.moveTo(cx, cy);
      });
      ctx.stroke();

      ctx.globalAlpha = 1;
      ctx.font = `600 ${Math.round(cell * 0.32)}px ${t.mono}`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      for (const [s, label] of [
        [start, 'S'],
        [goal, 'G'],
      ] as const) {
        const [cx, cy] = center(s);
        ctx.fillStyle = s === goal ? t.accent : t.surface;
        ctx.strokeStyle = t.accent;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(cx, cy, cell * 0.3, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = s === goal ? t.surface : t.accent;
        ctx.fillText(label, cx, cy + 1);
      }

      const differs = policy.filter((a, s) => a >= 0 && !(a === baseline.policy[s])).length;
      const cells = policy.filter((a) => a >= 0).length;
      const end = path[path.length - 1];
      const where = `$(${end % W}, ${Math.floor(end / W)})$`;
      const outcome =
        end === goal
          ? `Reaches $G$ in ${path.length - 1} steps (optimal: ${baseline.path.length - 1}).`
          : path.indexOf(end) === path.length - 2
            ? `Never reaches $G$: it stays at ${where}.`
            : `Never reaches $G$: it circles near ${where}.`;
      setStatus(status, `${outcome} Policy differs from the unshaped optimum in ${differs} of ${cells} cells.`);
    };

    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-mode]')) {
      b.addEventListener('click', () => {
        mode = b.dataset.mode!;
        root.querySelectorAll('[data-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        draw();
      });
    }
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-heat]')) {
      b.addEventListener('click', () => {
        heat = b.dataset.heat!;
        root.querySelectorAll('[data-heat]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        draw();
      });
    }
    slider.addEventListener('input', draw);
    redrawOn(canvas, draw);
  }
</script>
