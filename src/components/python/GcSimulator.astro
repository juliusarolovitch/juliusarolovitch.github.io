---
import katex from 'katex';

const tex = (s: string) => katex.renderToString(s);
---

<figure class="viz" data-gcsim>
  <div class="viz-controls">
    <label>surviving allocations/s <input type="range" min="2" max="4" step="0.05" value="3" data-rate /><output data-rate-out></output></label>
    <label>long-lived <input type="range" min="0" max="5" step="0.1" value="1" data-ll /><output data-ll-out></output></label>
    <label>speed <input type="range" min="0" max="3" step="1" value="2" data-speed /><output data-speed-out></output></label>
  </div>
  <div class="viz-controls">
    <div class="viz-seg"><button type="button" data-burst aria-pressed="false">burst of 40,000</button></div>
    <div class="viz-seg"><button type="button" data-collect aria-pressed="false"><Fragment set:html={tex(String.raw`\texttt{gc.collect()}`)} /></button></div>
    <div class="viz-seg"><button type="button" data-freeze aria-pressed="false"><Fragment set:html={tex(String.raw`\texttt{gc.freeze()}`)} /></button></div>
    <div class="viz-seg"><button type="button" data-reset aria-pressed="false">reset</button></div>
  </div>
  <canvas data-canvas role="img" aria-label="Simulated generation sizes and a timeline of collection pauses"></canvas>
  <p class="viz-status" data-status></p>
</figure>

<script>
  import { scaleLinear, scaleLog } from 'd3-scale';
  import { fitCanvas, redrawOn, setStatus, theme } from '../../lib/viz';

  const thresholds = [700, 10, 10];
  const costPerObject = 0.25e-3;
  const startup = 250000;
  const speeds = [1, 10, 60, 600];

  for (const root of document.querySelectorAll<HTMLElement>('[data-gcsim]')) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const rateIn = root.querySelector<HTMLInputElement>('[data-rate]')!;
    const llIn = root.querySelector<HTMLInputElement>('[data-ll]')!;
    const speedIn = root.querySelector<HTMLInputElement>('[data-speed]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let s: {
      time: number;
      gen: number[];
      perm: number;
      count: number[];
      total: number;
      pending: number;
      young: { t: number; g: number; scanned: number }[];
      old: { t: number; g: number; scanned: number }[];
      fulls: number;
      longest: number;
    };
    let visible = false;

    const reset = () => {
      s = { time: 0, gen: [0, 0, startup], perm: 0, count: [0, 0, 0], total: startup, pending: 0, young: [], old: [], fulls: 0, longest: 0 };
    };

    const collect = (g: number) => {
      const ll = Number(llIn.value) / 100;
      const scanned = s.gen.slice(0, g + 1).reduce((a, b) => a + b, 0);
      const young = s.gen[0];
      const survivors = ll * young + (g >= 1 ? s.gen[1] : 0) + (g === 2 ? s.gen[2] : 0);
      s.gen[0] = 0;
      if (g === 0) {
        s.gen[1] += survivors;
      } else {
        s.gen[1] = 0;
        if (g === 1) {
          s.gen[2] += survivors;
          s.pending += survivors;
        } else {
          s.gen[2] = survivors;
          s.total = survivors;
          s.pending = 0;
          s.fulls += 1;
        }
      }
      s.count[g] = 0;
      for (let i = 0; i < g; i++) s.count[i] = 0;
      if (g + 1 < 3) s.count[g + 1] += 1;
      const list = g === 0 ? s.young : s.old;
      list.push({ t: s.time, g, scanned });
      if (list.length > 3000) list.splice(0, list.length - 3000);
      s.longest = Math.max(s.longest, scanned * costPerObject);
    };

    const maybeCollect = () => {
      for (let g = 2; g >= 0; g--) {
        if (s.count[g] > thresholds[g]) {
          if (g === 2 && s.pending < s.total / 4) continue;
          collect(g);
          return;
        }
      }
    };

    const advance = (dt: number) => {
      const rate = 10 ** Number(rateIn.value);
      let remaining = rate * dt;
      let guard = 0;
      while (remaining > 0 && guard++ < 200000) {
        const need = thresholds[0] + 1 - s.count[0];
        const step = Math.min(need, remaining);
        s.count[0] += step;
        s.gen[0] += step;
        s.time += step / rate;
        remaining -= step;
        if (s.count[0] > thresholds[0]) maybeCollect();
      }
    };

    const draw = () => {
      const t = theme();
      const { ctx, width } = fitCanvas(canvas, 340);
      const rateLabel = Math.round(10 ** Number(rateIn.value));
      root.querySelector<HTMLOutputElement>('[data-rate-out]')!.value = rateLabel.toLocaleString();
      root.querySelector<HTMLOutputElement>('[data-ll-out]')!.value = `${Number(llIn.value).toFixed(1)}%`;
      root.querySelector<HTMLOutputElement>('[data-speed-out]')!.value = `${speeds[Number(speedIn.value)]}×`;

      const left = 82;
      const right = width - 74;
      const rowsTop = 34;
      const rowGap = 24;
      const bx = scaleLog().domain([1, 1e6]).range([left, right]).clamp(true);
      const rowsBottom = rowsTop + 3 * rowGap;
      ctx.font = `11px ${t.mono}`;
      ctx.lineWidth = 1;
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      ctx.fillStyle = t.fg;
      ctx.fillText('tracked objects per generation', left, 4);
      ctx.textAlign = 'center';
      for (const [v, label] of [[1, '1'], [10, '10'], [100, '100'], [1e3, '1k'], [1e4, '10k'], [1e5, '100k'], [1e6, '1M']] as const) {
        ctx.strokeStyle = t.line;
        ctx.beginPath();
        ctx.moveTo(Math.round(bx(v)) + 0.5, rowsTop - 10);
        ctx.lineTo(Math.round(bx(v)) + 0.5, rowsBottom + 10);
        ctx.stroke();
        ctx.fillStyle = t.muted;
        ctx.fillText(label, bx(v), rowsBottom + 14);
      }
      const rows = [
        { label: 'gen 0', v: s.gen[0], color: t.accent, alpha: 0.4 },
        { label: 'gen 1', v: s.gen[1], color: t.accent, alpha: 0.7 },
        { label: 'gen 2', v: s.gen[2], color: t.accent, alpha: 1 },
        { label: 'permanent', v: s.perm, color: t.muted, alpha: 0.6 },
      ];
      ctx.textBaseline = 'middle';
      rows.forEach((r, i) => {
        const y = rowsTop + i * rowGap;
        ctx.fillStyle = t.muted;
        ctx.textAlign = 'right';
        ctx.fillText(r.label, left - 8, y);
        if (r.v >= 1) {
          ctx.fillStyle = r.color;
          ctx.globalAlpha = r.alpha;
          ctx.beginPath();
          ctx.roundRect(left, y - 5, Math.max(3, bx(r.v) - left), 10, 5);
          ctx.fill();
          ctx.globalAlpha = 1;
        }
        ctx.fillStyle = t.fg;
        ctx.fillText(Math.round(r.v).toLocaleString(), width - 8, y);
      });
      const gy = rowsTop + 2 * rowGap;
      const trig = bx(Math.max(1, s.total / 4 + (s.gen[2] - s.pending)));
      ctx.strokeStyle = '#e05a47';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(trig, gy - 9);
      ctx.lineTo(trig, gy + 9);
      ctx.stroke();
      ctx.lineWidth = 1;

      const box = { x: left, y: rowsBottom + 60, w: width - 10 - left, h: 150 };
      const windowLen = Math.min(120 * speeds[Number(speedIn.value)], Math.max(s.time, 10));
      const tx = scaleLinear().domain([s.time - windowLen, s.time]).range([box.x, box.x + box.w]);
      const ty = scaleLog().domain([0.01, 1000]).range([box.y + box.h, box.y + 16]).clamp(true);
      ctx.textAlign = 'right';
      for (const [v, label] of [[0.01, '0.01 ms'], [0.1, '0.1 ms'], [1, '1 ms'], [10, '10 ms'], [100, '100 ms'], [1000, '1 s']] as const) {
        ctx.strokeStyle = t.line;
        ctx.beginPath();
        ctx.moveTo(box.x, Math.round(ty(v)) + 0.5);
        ctx.lineTo(box.x + box.w, Math.round(ty(v)) + 0.5);
        ctx.stroke();
        ctx.fillStyle = t.muted;
        ctx.fillText(label, box.x - 8, ty(v));
      }
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      ctx.fillStyle = t.fg;
      ctx.fillText('pause per collection (estimated)', box.x, box.y - 16);
      for (const e of [...s.young, ...s.old]) {
        if (e.t < s.time - windowLen) continue;
        const ms = e.scanned * costPerObject;
        if (e.g < 2) {
          ctx.fillStyle = t.accent;
          ctx.globalAlpha = e.g === 0 ? 0.25 : 0.6;
          ctx.beginPath();
          ctx.arc(tx(e.t), ty(ms), 1.6, 0, Math.PI * 2);
          ctx.fill();
          continue;
        }
        ctx.globalAlpha = 1;
        ctx.strokeStyle = '#e05a47';
        ctx.lineWidth = 2.4;
        ctx.beginPath();
        ctx.moveTo(tx(e.t), box.y + box.h);
        ctx.lineTo(tx(e.t), ty(ms));
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      ctx.lineWidth = 1;
      ctx.textAlign = 'right';
      ctx.fillStyle = '#e05a47';
      ctx.fillText('full pass', box.x + box.w, box.y - 16);
      const fw = ctx.measureText('full pass').width;
      ctx.fillStyle = t.accent;
      ctx.fillText('gen 0, gen 1', box.x + box.w - fw - 16, box.y - 16);
      ctx.fillStyle = t.muted;
      const span = windowLen >= 3600 ? `${(windowLen / 3600).toFixed(1)} h` : windowLen >= 60 ? `${Math.round(windowLen / 60)} min` : `${Math.round(windowLen)} s`;
      ctx.fillText('now', box.x + box.w, box.y + box.h + 6);
      ctx.textAlign = 'left';
      ctx.fillText(`${span} ago`, box.x, box.y + box.h + 6);

      const clock = s.time >= 3600 ? `${(s.time / 3600).toFixed(2)}\\,\\text{h}` : `${Math.round(s.time / 60)}\\,\\text{min}`;
      setStatus(
        status,
        `simulated $t = ${clock}$ · full passes: ${s.fulls} · longest pause $\\approx ${s.longest.toFixed(1)}\\,\\text{ms}$ · next full pass when $\\texttt{pending} > ${Math.round(s.total / 4).toLocaleString().replace(/,/g, '{,}')}$ (now ${Math.round(s.pending).toLocaleString()})`,
      );
    };

    root.querySelector('[data-burst]')!.addEventListener('click', () => {
      s.gen[2] += 40000;
      s.pending += 40000;
      draw();
    });
    root.querySelector('[data-collect]')!.addEventListener('click', () => {
      collect(2);
      draw();
    });
    root.querySelector('[data-freeze]')!.addEventListener('click', () => {
      s.perm += s.gen[0] + s.gen[1] + s.gen[2];
      s.gen = [0, 0, 0];
      s.count = [0, s.count[1], s.count[2]];
      draw();
    });
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      reset();
      draw();
    });
    for (const el of [rateIn, llIn, speedIn]) el.addEventListener('input', draw);

    reset();
    redrawOn(canvas, draw);
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);
    let last = performance.now();
    const loop = (stamp: number) => {
      const dt = Math.min(0.1, (stamp - last) / 1000);
      last = stamp;
      if (visible && !reduced) {
        advance(dt * speeds[Number(speedIn.value)]);
        draw();
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
    if (reduced) {
      advance(3600);
      draw();
    }
  }
</script>
